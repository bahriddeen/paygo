{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": { "@/*": ["./src/renderer/src/*"] },
    "noEmit": true
  },
  "include": ["src/renderer/src/**/*"],
  "exclude": ["**/*.test.ts", "**/*.test.tsx"]
}
